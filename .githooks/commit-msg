#!/bin/sh
# A commit message cites a decision board verdict as DECISIONS.md#REFERENCE, never by its
# verdict ID (#536). Every line is read, comment lines too, because a cleanup mode can keep
# them. Only the text below the scissors line of Git's own editor template, which Git removes,
# is not read: that line followed by Git's "Do not modify or remove the line above." A
# scissors line without it, as commit -F keeps it, is read with the text below it.
awk '
  held != "" { if ($0 == "# Do not modify or remove the line above.") exit; print held; held = "" }
  $0 == "# ------------------------ >8 ------------------------" { held = $0; next }
  { print }
  END { if (held != "") print held }
' "$1" | sh "$(git rev-parse --show-toplevel)/scripts/decision-citations.sh"
